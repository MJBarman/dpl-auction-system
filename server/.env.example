# Copy to server/.env for local use (gitignored). Hosted deployments (Render,
# Docker) should set these as real environment variables instead.

# Supabase project that holds the player-photo storage bucket.
# Dashboard → Project Settings → Data API → Project URL
SUPABASE_URL=https://xqzgvfscqfpdkmrwuezh.supabase.co

# Server-side storage key — NEVER expose this to browsers or commit it.
# Dashboard → Project Settings → API Keys → service_role (legacy) or a
# secret key (sb_secret_...). Either works; SUPABASE_SECRET_KEY is also read.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — bucket name, defaults to player-photos.
# SUPABASE_PHOTO_BUCKET=player-photos
